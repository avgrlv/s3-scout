# Скопируйте в .env и укажите свои ключи. Личный .env не публикуйте.
# Префиксы должны совпадать с credentials_env в config.yml.

# Yandex Object Storage (credentials_env: AWS)
AWS_ACCESS_KEY_ID=your_yandex_access_key
AWS_SECRET_ACCESS_KEY=your_yandex_secret_key
# AWS_SESSION_TOKEN=your_temporary_token

# Selectel (credentials_env: SELECTEL)
SELECTEL_ACCESS_KEY_ID=your_selectel_access_key
SELECTEL_SECRET_ACCESS_KEY=your_selectel_secret_key
# SELECTEL_SESSION_TOKEN=your_temporary_token
